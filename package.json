{
  "name": "web-python-editor",
  "version": "1.0.0",
  "description": "ブラウザ上で Python の編集から実行までを完結させる Chrome 拡張機能。",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "test": "node build.js && node --experimental-wasm-jspi --test \"test/*.test.js\"",
    "package": "node build.js && node package.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yokochi513/web-python-editor.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Yokochi513/web-python-editor/issues"
  },
  "homepage": "https://github.com/Yokochi513/web-python-editor#readme",
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "esbuild": "^0.28.2",
    "pyodide": "^314.0.7"
  }
}
